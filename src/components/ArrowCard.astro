---
import type { CollectionEntry } from "astro:content";
import FormattedDate from "./FormattedDate.astro";

type Props = {
  entry: CollectionEntry<"blog"> | CollectionEntry<"projects">;
};

const { entry } = Astro.props as {
  entry: CollectionEntry<"blog"> | CollectionEntry<"projects">;
};
---

<a
  href={`/${entry.collection}/${entry.id}`}
  class="not-prose group relative flex flex-nowrap rounded-lg border border-neutral-300/60 px-4 py-3 pr-10 transition-colors duration-150 ease-out hover:bg-neutral-100 hover:text-neutral-900 focus-visible:bg-neutral-100 focus-visible:text-neutral-900 dark:border-neutral-700/60 dark:hover:bg-neutral-800/60 dark:hover:text-white dark:focus-visible:bg-neutral-800/60 dark:focus-visible:text-white"
>
  <div class="flex min-w-0 flex-1 flex-col">
    <div class="font-semibold">{entry.data.title}</div>
    {
      entry.data.description && (
        <div class="line-clamp-2 text-sm text-neutral-600 dark:text-neutral-400">
          {entry.data.description}
        </div>
      )
    }
  </div>
  <time
    datetime={entry.data.date.toISOString()}
    class="ml-4 shrink-0 self-start pt-0.5 text-sm whitespace-nowrap text-neutral-500 dark:text-neutral-500"
  >
    <FormattedDate date={entry.data.date} />
  </time>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    aria-hidden="true"
    class="absolute right-2 top-1/2 size-5 -translate-y-1/2 fill-none stroke-current stroke-2"
  >
    <line
      x1="5"
      y1="12"
      x2="19"
      y2="12"
      class="translate-x-3 scale-x-0 transition-transform duration-150 ease-out group-hover:translate-x-0 group-hover:scale-x-100 group-focus-visible:translate-x-0 group-focus-visible:scale-x-100"
    ></line>
    <polyline
      points="12 5 19 12 12 19"
      class="-translate-x-1 transition-transform duration-150 ease-out group-hover:translate-x-0 group-focus-visible:translate-x-0"
    ></polyline>
  </svg>
</a>
