---
import { getCollection } from "astro:content";
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { siteConfig } from "@/config/site";
import { authorSlug, getAllAuthors, visiblePosts } from "@/lib/posts";

const allPosts = visiblePosts(await getCollection("posts"));
const authors = getAllAuthors(allPosts);
---

<BaseLayout
  title="About"
  description={`About ${siteConfig.name} — what it publishes and who writes it.`}
>
  <SiteHeader posts={allPosts} />
  <main id="content" class="outer">
    <div class="canvas">
      <header class="pagehead">
        <p class="eyebrow">About</p>
        <h1 class="pagehead-title">{siteConfig.name}</h1>
        <p class="pagehead-description">{siteConfig.about}</p>
      </header>

      <div class="prose">
        <h2>What I do</h2>
        <p>
          I'm Angelo, a senior machine learning researcher who spends his days teaching computers to
          look at teeth. I build AI for 3D dental imaging and, previously, radiology diagnostics, and
          I've co-authored patents in AI for dentistry.
        </p>

        <h2>What gets published here</h2>
        <p>
          Deep dives into physics-based simulations, machine learning models, and honest reflections
          about building in public.
        </p>

        <h2>Current obsession</h2>
        <p>LLMs, multimodal AI, and whatever new tool can make science or side projects go faster.</p>

        <h2>Beyond the code</h2>
        <ul>
          <li>Reading AI papers</li>
          <li>Building side projects: aDale.ink, Hirflow, and RetroLM</li>
          <li>Wondering if AI will save the world or just make better cat videos</li>
        </ul>

        <h2>Who writes it</h2>
        <ul>
          {
            authors.map((author) => (
              <li>
                <a href={`/author/${authorSlug(author.name)}/`}>{author.name}</a> — {author.role} ({author.posts.length} {author.posts.length === 1 ? "post" : "posts"})
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </main>
  <SiteFooter />
</BaseLayout>
