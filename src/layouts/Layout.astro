---
import Head from "@components/Head.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import Pagefind from "@components/PageFind.astro";
import { SITE } from "@consts";

type Props = {
  title: string;
  description: string;
  image?: string;
  math?: boolean;
};

const { title, description, image, math = false } = Astro.props;

const fullTitle = title === "Home" || !title ? SITE.TITLE : `${title} | ${SITE.TITLE}`;
---

<!doctype html>
<html lang="en">
  <head>
    <Head title={fullTitle} description={description} image={image} math={math} />
  </head>
  <body>
    <noscript>
      <style>
        .animate{
          opacity:1;
          translate: var(--tw-translate-x) calc(var(--spacing) * 0);
        }
      </style>
    </noscript>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <Pagefind />
  </body>
</html>
